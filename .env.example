# =====================================================================
# AI-01 — The AI-Native Company of One Environment Configuration
# =====================================================================
# Copy this file to .env and backend/.env and populate your credentials.

# LiveKit WebRTC Cloud Voice & Video Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Retell AI Telephony Credentials
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=your_retell_agent_id
RETELL_PHONE_NUMBER=+1234567890

# Authentication & Session Security
JWT_SECRET_KEY=generate_a_random_32_byte_secret_here

# MongoDB Atlas Configuration (Leave empty for zero-cost in-memory mock database)
MONGODB_URI=
DATABASE_NAME=ai01_db

# Google Gemini API Key
GEMINI_API_KEY=

# Vapi.ai Vernacular Voice (Optional legacy provider)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# Free WhatsApp Dispatcher Service (Baileys - $0 Zero-Cost)
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_SERVICE_TOKEN=ai01_whatsapp_secret_2026
WHATSAPP_SERVICE_PORT=3001
WHATSAPP_OWNER_PHONE=+919876543210
WHATSAPP_AUTHORIZED_PHONES=+919876543210

# Twilio WhatsApp Sandbox Credentials (Legacy Fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Server Port
PORT=8000
HOST=127.0.0.1
