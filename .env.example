# =====================================================================
# AI-01 — The AI-Native Company of One Environment Configuration
# =====================================================================
# Note: AI-01 operates out of the box with $0 Zero-Cost Architecture!
# All external services have realistic offline fallbacks and simulations.
# To connect live external APIs and MongoDB Atlas, fill in the values below:

# MongoDB Atlas Configuration
MONGODB_URI=
DATABASE_NAME=ai01_db

# Google AI Studio Gemini API Key
GEMINI_API_KEY=

# Vapi.ai Vernacular Voice Calling API
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# Free WhatsApp Dispatcher Service (Baileys - $0 Zero-Cost)
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_SERVICE_TOKEN=change_this_secret
WHATSAPP_SERVICE_PORT=3001
WHATSAPP_OWNER_PHONE=+919876543210
WHATSAPP_AUTHORIZED_PHONES=+919876543210

# Twilio WhatsApp Sandbox Credentials (Legacy Fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Server Port
PORT=8000
HOST=127.0.0.1
