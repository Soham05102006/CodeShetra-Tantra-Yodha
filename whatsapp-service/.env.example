# =====================================================================
# Free WhatsApp Service (Baileys) Configuration
# =====================================================================

# Port for the Node.js WhatsApp microservice
PORT=3001

# Service-to-service secret token for REST API security
# Must match WHATSAPP_SERVICE_TOKEN in backend/.env
WHATSAPP_SERVICE_TOKEN=change_this_secret_token

# FastAPI Backend Webhook URL for incoming WhatsApp messages
FASTAPI_WEBHOOK_URL=http://127.0.0.1:8000/api/whatsapp/incoming

# Session credentials directory (persisted locally across restarts)
AUTH_DIR=./auth_info

