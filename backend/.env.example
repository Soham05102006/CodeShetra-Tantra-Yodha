# =====================================================================
# AI-01 Backend Environment Configuration
# =====================================================================

# LiveKit WebRTC Cloud Voice & Video
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Retell AI Telephony
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=your_retell_agent_id
RETELL_PHONE_NUMBER=+1234567890

# Authentication JWT Secret
JWT_SECRET_KEY=generate_a_random_32_byte_secret_here

# MongoDB Atlas
MONGODB_URI=
DATABASE_NAME=ai01_db

# Google Gemini API
GEMINI_API_KEY=

# Server
PORT=8000
HOST=127.0.0.1

